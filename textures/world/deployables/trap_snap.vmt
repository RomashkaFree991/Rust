"VertexLitGeneric"
{
	"$basetexture" "models/zohart/deployables/trap_snap_diff"
	"$bumpmap" "models/zohart/deployables/trap_snap_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.025 0.025 0.025 ]"
	"$normalmapalphaenvmapmask" "1"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "30"
	"$phongboost" "0.1"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}