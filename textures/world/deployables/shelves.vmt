"VertexLitGeneric"
{
	"$basetexture" "models/zohart/deployables/shelves_diff"
	"$bumpmap" "models/zohart/deployables/shelves_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.015 0.015 0.015 ]"
	"$normalmapalphaenvmapmask" "1"

	"$ambientocclusion" "1"
	"$ambientoccltexture" "models/zohart/deployables/shelves_ao"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "30"
	"$phongboost" "0.2"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]"
	"$phongalbedotint" "1"
}