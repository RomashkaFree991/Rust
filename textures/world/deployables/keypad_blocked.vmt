"VertexLitGeneric"
{
	"$basetexture" "models/zohart/deployables/keypad_diff"
	"$bumpmap" "models/zohart/deployables/keypad_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.2 0.2 0.2 ]"
	"$normalmapalphaenvmapmask" "1"

	"$EmissiveBlendEnabled" "1"
	"$EmissiveBlendStrength" "1"
	"$EmissiveBlendTexture" "vgui/white"
	"$EmissiveBlendBaseTexture" "models/zohart/deployables/keypad_blocked_emission"
	"$EmissiveBlendTint" "[1 0.07 0.09]"

	"$ambientocclusion" "1"
	"$ambientoccltexture" "models/zohart/deployables/keypad_ao"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "100"
	"$phongboost" "1"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}
