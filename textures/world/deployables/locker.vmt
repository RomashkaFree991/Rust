"VertexLitGeneric"
{
	"$basetexture" "models/zohart/deployables/locker_diff"
	"$bumpmap" "models/zohart/deployables/locker_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.0175 0.0175 0.0175 ]"
	"$normalmapalphaenvmapmask" "1"

	"$ambientocclusion" "1"
	"$ambientoccltexture" "models/zohart/deployables/locker_ao"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost" "0.125"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}