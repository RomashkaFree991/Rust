"VertexlitGeneric"
{
	"$basetexture" "models/deployable/shelves_dif"
	"$bumpmap" "models/deployable/shelves_nrm"
	$blendtintbybasealpha 1
	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" "1"
    "$envmaptint"				  "[0.01 0.01 0.010]"
    "$envmapcontrast"             "1"


	"$surfaceprop" "metal"
	"$multipass" 0

	"$phong" "1"
	"$phongexponent" "1"
	"$phongboost" "1"
	"$phongfresnelranges"	"[0. 0.9 1.6]"
}