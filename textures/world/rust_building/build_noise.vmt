UnlitGeneric
{
	"$basetexture"	"models/darky_m/rust_building/build_noise"
	"$translucent" "1"
	"$model" "1"
	"$nofog" 1

	"$angle" 45
	"$translate" "[0.0 0.0]"
	"$center" "[0.5 0.5]"
	"$scale" "[5 5]"

	"Proxies"
	{
		"LinearRamp"
		{
			"rate" -0.5
			"initialValue" 0.5
			"resultVar" "$translate"
		}

		"TextureTransform"
		{
			"translateVar" "$translate"
			"scaleVar" "$scale"
			"rotateVar" "$angle"
			"centerVar" "$center"
			"resultVar" "$basetexturetransform"
		}
	}
}
