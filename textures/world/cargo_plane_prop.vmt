"VertexLitGeneric"
{
	"$basetexture"   "models/darky_m/rust/Cargo_plane_prop"
	"$translucent" "1"
	$nocull 1

	"$angle" 0
	"$translate" "[0.0 0.0]"
	"$center" "[0.5 0.5]"
	"$scale" "[1 1]"

	"Proxies"
	{
		"LinearRamp"
		{
			"rate" 1024
			"initialValue" 0
			"resultVar" "$angle"
		}

		"TextureTransform"
		{
			"translateVar" "$translate"
			"scaleVar" "$scale"
			"rotateVar" "$angle"
			"centerVar" "$center"
			"resultVar" "$basetexturetransform"
		}
	}
}
