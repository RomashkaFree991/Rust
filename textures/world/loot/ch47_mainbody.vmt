"VertexLitGeneric"
{
	"$basetexture" "models/zohart/loot/ch47_mainbody_diff"
	"$bumpmap" "models/zohart/loot/ch47_mainbody_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.005 0.005 0.005 ]"
	"$normalmapalphaenvmapmask" "1"

	"$halflambert" "1"
	"$nocull" "1"

	"$phong" "1"
	"$phongexponent" "30"
	"$phongboost" "0.3"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}