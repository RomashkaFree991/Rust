"VertexLitGeneric"
{
	"$basetexture" "models/zohart/loot/patrol_helicopter_rotor_diff"

	"$color2" "{200 200 200}"

	"$translucent" "1"
	"$halflambert" "1"
	"$nocull" "1"

	"$basetexturetransformcenter"      "[0.5 0.5]"
	"$basetexturetransformrotation"    "0"

	"Proxies"
	{
		"LinearRamp"
		{
			"rate" "2000"
			"initialValue" "0"
			"resultVar" "$basetexturetransformrotation"
		}
		"TextureTransform"
		{
			"centerVar"     "$basetexturetransformcenter"
			"rotateVar"     "$basetexturetransformrotation"
			"resultVar"     "$basetexturetransform"
		}
	}
}