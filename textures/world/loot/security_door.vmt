"VertexLitGeneric"
{
	"$basetexture" "models/zohart/loot/security_door_diff"
	"$bumpmap" "models/zohart/loot/security_door_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.0075 0.0075 0.0075 ]"
	"$normalmapalphaenvmapmask" "1"

	"$ambientocclusion" "1"
	"$ambientoccltexture" "models/zohart/loot/security_door_ao"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "100"
	"$phongboost" "0.25"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}