"VertexLitGeneric"
{
	"$basetexture" "models/zohart/loot/roadsign_diff"
	"$bumpmap" "models/zohart/loot/roadsign_nrm"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ 0.025 0.025 0.025 ]"
	"$normalmapalphaenvmapmask" "1"

	"$halflambert" "1"

	"$phong" "1"
	"$phongexponent" "70"
	"$phongboost" "0.35"
	"$phongfresnelranges" "[1 8 4]"
	"$phongtint" "[0.9 0.9 1]" 
	"$phongalbedotint" "1"
}